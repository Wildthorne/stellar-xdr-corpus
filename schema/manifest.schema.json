{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/xdr-corpus/manifest.schema.json",
  "title": "Stellar XDR/CAP coverage corpus manifest (draft 0.1)",
  "description": "One manifest per corpus. Each entry is one rare but valid ledger shape, stored as raw XDR files plus the values any decoder must get back. Language-neutral: expected values are JSON Pointers into the SEP-0051 XDR-JSON form produced by rs-stellar-xdr (`stellar xdr decode --output json`).",
  "type": "object",
  "required": ["schema_version", "generator", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "cap": {
      "type": "string",
      "pattern": "^CAP-[0-9]{4}$",
      "description": "CAP that introduced or changed the shape, e.g. CAP-0040."
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "xdrType": {
      "type": "string",
      "description": "Top-level XDR type name as in the .x files (stellar-xdr).",
      "enum": [
        "TransactionEnvelope",
        "TransactionResult",
        "TransactionResultPair",
        "TransactionMeta",
        "LedgerCloseMeta",
        "LedgerEntry",
        "LedgerEntryChanges",
        "ScVal",
        "ContractEvent",
        "SorobanAuthorizationEntry"
      ]
    },
    "file": {
      "type": "object",
      "required": ["role", "xdr_type", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": ["envelope", "result", "meta", "ledger_close_meta", "value"],
          "description": "What the file is. ledger_close_meta is the whole ledger, so a harness can feed it through a Galexie layout or a mock getLedgers endpoint."
        },
        "xdr_type": { "$ref": "#/$defs/xdrType" },
        "path": { "type": "string", "description": "Relative to the manifest. Raw XDR bytes, no base64." },
        "encoding": { "const": "binary", "default": "binary" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "expectation": {
      "type": "object",
      "required": ["file", "pointer", "equals"],
      "additionalProperties": false,
      "properties": {
        "file": { "enum": ["envelope", "result", "meta", "ledger_close_meta", "value"] },
        "pointer": { "type": "string", "pattern": "^(/[^/]*)*$", "description": "RFC 6901 JSON Pointer into the SEP-0051 XDR-JSON of that file." },
        "equals": { "description": "Exact expected value at that pointer." },
        "why": { "type": "string" }
      }
    },
    "derived": {
      "type": "object",
      "required": ["name", "value", "how"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "e.g. liquidity_pool_id, participants, signer_strkey" },
        "value": { "description": "Expected value. Arrays are sets unless `ordered` is true." },
        "ordered": { "type": "boolean", "default": false },
        "how": { "type": "string", "description": "How a consumer is expected to compute it, in one sentence." }
      }
    },
    "sighting": {
      "type": "object",
      "required": ["url", "component"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "component": { "type": "string", "description": "e.g. js-stellar-sdk, wallet-backend, stellar-etl" },
        "fixed_in": { "type": "string" },
        "reproduced": { "type": "boolean", "description": "true when this corpus entry has been shown to trip the pre-fix version" },
        "evidence": { "type": "string", "description": "Path to the reproduction log, relative to the manifest." }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "title", "caps", "protocol_version", "network", "source", "synthetic", "files", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cap[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{2}$",
          "description": "cap<primary CAP>-<shape>-<nn>. Stable across regenerations, so findings can cite it."
        },
        "title": { "type": "string" },
        "caps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cap" }, "description": "Primary CAP first." },
        "min_protocol": { "type": "integer", "minimum": 1, "description": "First protocol in which the shape can appear." },
        "protocol_version": { "type": "integer", "minimum": 1, "description": "Ledger protocol version of the ledger the entry was captured from." },
        "shape": {
          "type": "object",
          "properties": {
            "where": { "type": "string", "description": "XDR path to the rare part, e.g. TransactionEnvelope.tx.operations[0].body.change_trust.line.pool_share" },
            "what": { "type": "string", "description": "Why the shape is rare or easy to get wrong." }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "network": {
          "type": "object",
          "required": ["name", "passphrase"],
          "properties": {
            "name": { "enum": ["mainnet", "testnet", "futurenet", "local"] },
            "passphrase": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["network-history", "local-core", "synthetic"],
              "description": "network-history = captured from a live network; local-core = emitted by a local stellar-core; synthetic = hand-crafted bytes core never emitted."
            },
            "ledger": { "type": "integer", "minimum": 1 },
            "tx_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "op_index": { "type": "integer", "minimum": 0 },
            "close_time": { "type": "string", "format": "date-time" },
            "captured_via": { "type": "string", "description": "e.g. rpc getTransaction + getLedgers, galexie, history archive" },
            "recipe": { "type": "string", "description": "Generator step that recreates the shape on any network passphrase." }
          }
        },
        "synthetic": { "type": "boolean" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "expected": {
          "type": "object",
          "required": ["round_trip"],
          "additionalProperties": false,
          "properties": {
            "round_trip": { "type": "boolean", "description": "Decoding and re-encoding every file must give back the same bytes." },
            "decoded": { "type": "array", "items": { "$ref": "#/$defs/expectation" } },
            "derived": { "type": "array", "items": { "$ref": "#/$defs/derived" } },
            "nonconsensus": {
              "type": "array",
              "description": "JSON Pointers (into the meta) of values that are not consensus data and may differ between nodes for the same transaction, e.g. diagnostic events with node-measured timings. Byte comparisons of meta mask these.",
              "items": {
                "type": "object",
                "required": ["pointer", "why"],
                "additionalProperties": false,
                "properties": {
                  "pointer": { "type": "string", "pattern": "^(/[^/]*)*$" },
                  "why": { "type": "string" }
                }
              }
            },
            "events": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of contract events in the meta. Pins shapes whose point is that they emit none (CAP-0073 trust)."
            }
          }
        },
        "sightings": { "type": "array", "items": { "$ref": "#/$defs/sighting" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "properties": { "kind": { "const": "synthetic" } } } } },
          "then": { "properties": { "synthetic": { "const": true } } },
          "else": {
            "properties": { "synthetic": { "const": false } },
            "required": ["source"],
            "description": "Non-synthetic entries must say where they came from."
          }
        }
      ]
    }
  }
}
